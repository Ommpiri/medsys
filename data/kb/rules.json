      "source": "niddk",
      "source_url": "https://www.niddk.nih.gov/health-information/digestive-diseases/appendicitis/symptoms-causes"
    },
    {
      "id": "R25",
      "disease_id": "hepatitis_a",
      "conditions": {"all": ["jaundice", "dark_urine", "clay_colored_stools"]},
