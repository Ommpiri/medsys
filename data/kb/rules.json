    {
      "id": "R37",
      "disease_id": "depression",
      "conditions": {"all": ["persistent_sadness", "loss_of_interest", "feelings_worthless"]},
      "exclusions": ["fever"],
      "weight": 0.94,
      "severity": "moderate",
      "priority": 1,
