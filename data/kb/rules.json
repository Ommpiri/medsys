      "exclusions": [],
      "weight": 0.91,
      "severity": "moderate",
      "priority": 1,
      "explanation": "Osmotic diuresis manifestations (polyuria and compensatory polydipsia) provide strong clinical indication of hyperglycemia / Diabetes Mellitus.",
